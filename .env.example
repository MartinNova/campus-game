# Copy to .env.local and fill in. Never commit .env.local.

# Optional: show real team names + student IDs locally (e.g. for the presentation).
# Format: "First Last:StudentID,First Last:StudentID". Empty = placeholder accounts.
NEXT_PUBLIC_TEAM_MEMBERS=

# Supabase (auth + database). Leave empty to keep the demo login.
# Setup with "Sign in with Microsoft": docs/microsoft-login.md. Open-Meteo needs no API key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Comma-separated e-mail domains that may sign in.
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS=novasbe.pt
