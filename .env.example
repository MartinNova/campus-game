# Copy to .env.local and fill in. Never commit .env.local.

# Optional: show real team names + student IDs locally (e.g. for the presentation).
# Format: "First Last:StudentID,First Last:StudentID". Empty = placeholder accounts.
NEXT_PUBLIC_TEAM_MEMBERS=

# Supabase (accounts + database). Leave empty to keep the demo login.
# Setup: docs/accounts.md. Open-Meteo needs no API key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: comma-separated e-mail domains that may sign in, e.g. novasbe.pt. Empty = everyone.
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS=

# "true" shows "Sign in with Microsoft" (needs the Azure setup in docs/microsoft-login.md).
NEXT_PUBLIC_MICROSOFT_LOGIN=false
